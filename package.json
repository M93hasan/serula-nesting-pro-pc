{
  "name": "serula-nesting-pro-pc",
  "productName": "Serula Nesting Pro PC",
  "version": "0.1.11",
  "private": true,
  "description": "Serula Nesting Pro hybrid online/offline Windows desktop application",
  "author": "Muhammet Hasanoğlu",
  "main": "desktop/main.cjs",
  "scripts": {
    "offline:prepare": "node scripts/prepare-offline.cjs",
    "offline:test": "node --test tests/offline-server.test.cjs tests/hybrid-mode.test.cjs tests/selection-colors.test.cjs",
    "desktop:dev": "npm run offline:prepare && electron .",
    "dist:win": "npm run offline:prepare && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.serula.nesting.pro.pc",
    "productName": "Serula Nesting Pro PC",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Serula Nesting Pro PC"
    },
    "artifactName": "Serula-Nesting-Pro-PC-Setup.${ext}",
    "extraResources": [
      {
        "from": "desktop/bridge",
        "to": "serula-bridge",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "offline-web",
        "to": "serula-offline-web",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
